# ═══════════════════════════════════════════════════════════════
# gobhunter — Configuration Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── Job Search Settings ────────────────────────────────────
# The query sent to each job site's search.
SEARCH_QUERY=Python Backend Developer

# Comma-separated list of cities to search in.
SEARCH_LOCATIONS=Bangalore,Bengaluru,Remote

# ── Title Relevance Filters ─────────────────────────────────
# Comma-separated keywords. A job title is considered relevant
# if it contains ANY of these (case-insensitive match).
# Examples: "Python", "Backend", "Software Engineer", "Django"
INCLUDE_KEYWORDS=Python,Backend,Software Engineer

# Comma-separated keywords to EXCLUDE from titles, in addition
# to the built-in excludes (Senior, Sr, Staff, Principal, Lead,
# and level indicators [2-9], II, III, IV, V).
# Leave blank to rely on built-in excludes only.
EXCLUDE_KEYWORDS=

# ── Auto-Fill Personal Info ────────────────────────────────
# Your name, email, phone — used to fill application forms.
APPLICANT_NAME=
APPLICANT_EMAIL=
APPLICANT_PHONE=
APPLICANT_LINKEDIN=
APPLICANT_PORTFOLIO=
APPLICANT_COVER_LETTER=

# Path to your resume PDF file.
RESUME_PATH=

# ── Browser Settings ───────────────────────────────────────
# Locale and timezone used by the Playwright browser instance.
BROWSER_LOCALE=en-IN
BROWSER_TIMEZONE=Asia/Kolkata

# ── Dashboard ──────────────────────────────────────────────
# Port for the local web dashboard.
DASHBOARD_PORT=8765
