# ═══════════════════════════════════════════════════════════════
# gobhunter — Configuration
# ═══════════════════════════════════════════════════════════════

# ── Job Search Settings ────────────────────────────────────
# The query sent to each job site's search. One phrase only.
# For multiple roles, loop: SEARCH_QUERY="UI Developer" python main.py scrape
SEARCH_QUERY=Frontend Developer

# Comma-separated list of cities to search in.
SEARCH_LOCATIONS=Remote,Bangalore,Bengaluru,Hyderabad

# ── Title Relevance Filters ─────────────────────────────────
# A title is relevant if it contains ANY of these (case-insensitive).
# No bare "UI" or "AI" here: matching is substring-based, so "UI"
# would match "Build Engineer" and "AI" would match "Retail".
INCLUDE_KEYWORDS=React,React Native,Frontend,Front End,Front-End,UI Developer,UI Engineer,UI/UX,JavaScript,TypeScript,Angular,Vue,Next.js,Web Developer,WordPress,Flutter,Android Developer,iOS Developer,Mobile App,Full Stack,Fullstack,Full-Stack

# Excluded in addition to the built-ins (Senior, Sr, Staff, Principal,
# Lead, and level indicators [2-9], II, III, IV, V).
# Never put bare "Java" here. With the \w* fix in config.py it would
# also kill every JavaScript role.
EXCLUDE_KEYWORDS=Intern,Trainee,Fresher,Recruiter,Tester,Backend,Back End,Back-End,Python,Golang,Django,Flask,Spring Boot,DevOps,Data Engineer

# ── Auto-Fill Personal Info ────────────────────────────────
# These are typed into live application forms by Playwright.
# Filled from your EFG details. Change them if this job hunt
# should use a personal email or an Indian number.
APPLICANT_NAME=Mohamed Aaqib
APPLICANT_EMAIL=drop.mohamedaaqib@gmail.com
APPLICANT_PHONE=+91 8553255805
APPLICANT_LINKEDIN=https://www.linkedin.com/in/mohamed-aaqib3005/
APPLICANT_PORTFOLIO=
APPLICANT_COVER_LETTER=I am a frontend-focused software engineer with 3+ years of experience building production web and mobile applications using React, Next.js, TypeScript, and React Native. I would welcome the opportunity to discuss how my experience aligns with this role.

# Fallback resume, used for any job you have not tailored for yet.
RESUME_PATH=/home/aaqib/Desktop/BitbyBit/projects/gobhunter/resumes/base-resume.pdf

# ── Browser Settings ───────────────────────────────────────
BROWSER_LOCALE=en-IN
BROWSER_TIMEZONE=Asia/Kolkata

# ── Dashboard ──────────────────────────────────────────────
DASHBOARD_PORT=8765

# ── Shapeshifter Resume Customizer ────────────────────────
# Shape Shifter's server must be running on this port.
SHAPESHIFTER_URL=http://localhost:3001
# Where Shape Shifter POSTs the finished PDF back. This is the
# gobhunter dashboard, so it must be running when a job completes.
SHAPESHIFTER_CALLBACK_URL=http://localhost:8765/api/v1/resumes
SHAPESHIFTER_TEMPLATE=modern
SHAPESHIFTER_USER_ID=default
# Your full raw background, sent to Shape Shifter as profile text.
PROFILE_PATH=profile.md